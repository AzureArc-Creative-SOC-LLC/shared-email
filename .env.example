# Copy to .env alongside order-email.js on the VPS (/var/www/shared-email/.env)

# Primary provider: per-brand TurboSMTP accounts (same vars as user-order-service).
# A brand's domain must be listed in one account's DOMAINS and verified there.
TURBOSMTP_HOST=pro.turbo-smtp.com
TURBOSMTP_PORT=587
TURBOSMTP_1_USER=
TURBOSMTP_1_PASS=
TURBOSMTP_1_DOMAINS=
TURBOSMTP_2_USER=
TURBOSMTP_2_PASS=
TURBOSMTP_2_DOMAINS=
TURBOSMTP_3_USER=
TURBOSMTP_3_PASS=
TURBOSMTP_3_DOMAINS=
TURBOSMTP_FALLBACK_ACCOUNT=

# Secondary provider
RESEND_API_KEY=

# SMTP fallback (used only if Resend is unconfigured or the send fails).
# This is also the fallback mailbox for any domain below that doesn't have
# its own dedicated SMTP_*_<DOMAIN> credentials configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Per-domain SMTP override (optional, recommended for production) — lets a
# brand send from its own real mailbox instead of the shared one above.
# Most SMTP providers (Gmail included) require the authenticated account to
# match the "From" address, so without this every brand's email would show
# as coming from the one shared mailbox regardless of brand-config.js's
# "from" field.
#
# Env var name = SMTP_{FIELD}_{DOMAIN uppercased, non-alphanumeric -> "_"}
# Example for jupyterlabs.net:
# SMTP_HOST_JUPYTERLABS_NET=smtp.gmail.com
# SMTP_PORT_JUPYTERLABS_NET=587
# SMTP_SECURE_JUPYTERLABS_NET=false
# SMTP_USER_JUPYTERLABS_NET=orders@jupyterlabs.net
# SMTP_PASS_JUPYTERLABS_NET=
